{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mapunite:schema:emission-standard:1",
  "title": "MapUnite emission_standard table",
  "description": "Indian two-wheeler emission stages. Limits in kg/m (1 g/km = 1e-6 kg/m). Generated by scripts/build-bike-schema.mjs — do not edit by hand.",
  "type": "object",
  "required": [
    "schema_version",
    "table",
    "sources",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "table": {
      "const": "emission_standard"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "effective_from",
          "test_cycle",
          "obd_stage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "effective_from": {
            "description": "first date of manufacture/registration the stage applies to",
            "type": "object",
            "$ref": "#/$defs/fact",
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
              }
            }
          },
          "test_cycle": {
            "type": "object",
            "$ref": "#/$defs/fact",
            "properties": {
              "value": {
                "enum": [
                  "IDC",
                  "WMTC"
                ]
              }
            }
          },
          "obd_stage": {
            "type": "object",
            "$ref": "#/$defs/fact",
            "properties": {
              "value": {
                "enum": [
                  "none",
                  "OBD-I",
                  "OBD-II-A",
                  "OBD-II-B"
                ]
              }
            }
          },
          "limits": {
            "type": "object",
            "required": [],
            "properties": {
              "co": {
                "type": "object",
                "$ref": "#/$defs/quantity",
                "properties": {
                  "unit": {
                    "const": "kg/m"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.0001
                  }
                }
              },
              "thc": {
                "type": "object",
                "$ref": "#/$defs/quantity",
                "properties": {
                  "unit": {
                    "const": "kg/m"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.0001
                  }
                }
              },
              "nmhc": {
                "type": "object",
                "$ref": "#/$defs/quantity",
                "properties": {
                  "unit": {
                    "const": "kg/m"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.0001
                  }
                }
              },
              "nox": {
                "type": "object",
                "$ref": "#/$defs/quantity",
                "properties": {
                  "unit": {
                    "const": "kg/m"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.0001
                  }
                }
              },
              "hc_nox": {
                "type": "object",
                "$ref": "#/$defs/quantity",
                "properties": {
                  "unit": {
                    "const": "kg/m"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.0001
                  }
                }
              },
              "pm": {
                "type": "object",
                "$ref": "#/$defs/quantity",
                "properties": {
                  "unit": {
                    "const": "kg/m"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.0001
                  }
                }
              }
            },
            "additionalProperties": false
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uncertainty": {
      "description": "Spread of the value. normal: sd in the value's unit; lognormal: sigma of ln(value); uniform: hard interval in the value's unit.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "dist",
            "sd"
          ],
          "properties": {
            "dist": {
              "const": "normal"
            },
            "sd": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "dist",
            "sigma_ln"
          ],
          "properties": {
            "dist": {
              "const": "lognormal"
            },
            "sigma_ln": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "dist",
            "min",
            "max"
          ],
          "properties": {
            "dist": {
              "const": "uniform"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "uncertaintyArray": {
      "description": "Per-element spread of a vector quantity.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "dist",
            "sd"
          ],
          "properties": {
            "dist": {
              "const": "normal"
            },
            "sd": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "dist",
            "sigma_ln"
          ],
          "properties": {
            "dist": {
              "const": "lognormal"
            },
            "sigma_ln": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "quantity": {
      "description": "A number with its SI unit (UCUM code) and provenance. Each use site fixes the unit with a const.",
      "type": "object",
      "required": [
        "value",
        "unit",
        "source",
        "confidence",
        "method"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "id of an entry in this file's sources"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "trust in this value, 0 (none) to 1 (certain)"
        },
        "method": {
          "enum": [
            "published",
            "measured",
            "derived",
            "estimated",
            "class_default",
            "calibrated"
          ]
        },
        "published": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "the published text verbatim, before SI conversion (required when method is published)"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "published"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "published"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "estimated"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "number",
                "maximum": 0.6
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "class_default"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "number",
                "maximum": 0.5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "estimated",
                  "class_default"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "uncertainty"
            ]
          }
        }
      ]
    },
    "quantityArray": {
      "description": "Several numbers sharing one unit and one provenance (e.g. gear ratios).",
      "type": "object",
      "required": [
        "values",
        "unit",
        "source",
        "confidence",
        "method"
      ],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "unit": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "id of an entry in this file's sources"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "trust in this value, 0 (none) to 1 (certain)"
        },
        "method": {
          "enum": [
            "published",
            "measured",
            "derived",
            "estimated",
            "class_default",
            "calibrated"
          ]
        },
        "published": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "the published text verbatim, before SI conversion (required when method is published)"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertaintyArray"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "published"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "published"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "estimated"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "number",
                "maximum": 0.6
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "class_default"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "number",
                "maximum": 0.5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "estimated",
                  "class_default"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "uncertainty"
            ]
          }
        }
      ]
    },
    "fact": {
      "description": "A categorical, textual or boolean value with provenance.",
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence",
        "method"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "id of an entry in this file's sources"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "trust in this value, 0 (none) to 1 (certain)"
        },
        "method": {
          "enum": [
            "published",
            "measured",
            "derived",
            "estimated",
            "class_default",
            "calibrated"
          ]
        },
        "published": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "the published text verbatim, before SI conversion (required when method is published)"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "published"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "published"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "estimated"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "number",
                "maximum": 0.6
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "class_default"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "number",
                "maximum": 0.5
              }
            }
          }
        }
      ]
    },
    "source": {
      "description": "Where values came from. Web pages need url + accessed; documents need a citation; an engineering estimate states its rationale; a class_default source names the class-default bundle.",
      "type": "object",
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "kind": {
          "enum": [
            "oem_spec_sheet",
            "oem_owner_manual",
            "oem_press_release",
            "press",
            "regulation",
            "dataset",
            "standard",
            "reference_book",
            "peer_reviewed",
            "engineering_estimate",
            "class_default"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "pattern": "^https?:\\/\\/[^\\s/$.?#][^\\s]*$"
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "published_date": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "citation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "class_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "oem_spec_sheet",
                  "oem_owner_manual",
                  "oem_press_release",
                  "press",
                  "regulation",
                  "dataset"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "url",
              "accessed"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "standard",
                  "reference_book",
                  "peer_reviewed"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "citation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "engineering_estimate"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "rationale"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "class_default"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "class_ref"
            ]
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  }
}
